@page "/canvas"
@using Mandelbrot

<h3>Canvas</h3>

<div class="d-flex" style="gap: 1rem; align-items: flex-start;">
    <canvas id="mandelbrot-canvas" width="400" height="400"></canvas>

    <form style="min-width: 400px;">
        <h5>Huidig viewport (gerenderd)</h5>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label">Real</label>
            <input class="col-sm-9 form-control" value="@currentPos" type="text" readonly />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label">Imaginary</label>
            <input class="col-sm-9 form-control" value="@currentPosi" type="text" readonly />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label">Viewport size</label>
            <input class="col-sm-9 form-control" value="@currentSize" type="text" readonly />
        </div>

        <h5 class="mt-3">Volgend viewport</h5>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="mpos">Real</label>
            <input class="col-sm-9 form-control" id="mpos" value="@mPos" @onchange="@((ChangeEventArgs e) => mPos = bigDecimalFactory.FromString(e.Value.ToString()))" type="text" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="mposi">Imaginary</label>
            <input class="col-sm-9 form-control" id="mposi" value="@mPosi" @onchange="@((ChangeEventArgs e) => mPosi = bigDecimalFactory.FromString(e.Value.ToString()))" type="text" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="msize">Viewport size</label>
            <input class="col-sm-9 form-control" id="msize" value="@mSize" @onchange="@((ChangeEventArgs e) => mSize = bigDecimalFactory.FromString(e.Value.ToString()))" type="text" />
        </div>

        <h5 class="mt-3">Parameters</h5>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="iterationlimit">Iteration limit</label>
            <input class="col-sm-9 form-control" id="iterationlimit" @bind="iterationlimit" type="text" placeholder="Iteration limit" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="x">x</label>
            <input class="col-sm-9 form-control" id="x" @bind="x" type="text" placeholder="x" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="y">y</label>
            <input class="col-sm-9 form-control" id="y" @bind="y" type="text" placeholder="y" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label" for="selectedsize">Selected size</label>
            <input class="col-sm-9 form-control" id="selectedsize" @bind="selectedSize" type="text" placeholder="Selected size" />
        </div>
        <div class="form-group row">
            <label class="col-sm-3 col-form-label">Offset</label>
            <input class="col-sm-9 form-control" type="number" @onchange="listFromChanged" />
        </div>
        <div class="form-group row">
            <button class="btn btn-primary mr-1" type="button" @onclick="ServerGenerate">Server</button>
            <button class="btn btn-primary mr-1" type="button" @onclick="Generate">Generate</button>
            <button class="btn btn-primary mr-1" type="button" @onclick="Test">Test</button>
            <button class="btn btn-primary mr-1" type="button" @onclick="SetCoordsClicked">SetCoords</button>
        </div>
    </form>
</div>

<div>
    <h3>Fractal</h3>
    @if (fractal != null && listFromNumberValid)
    {
        for (int row = 0; row < 16; row++)
        {
            @string.Format("{0:X4}", listFromNumber + row * 8)
            for (int i = 0; i < 8; i++)
            {
                <span>@fractal[listFromNumber + i].ToString("D4")</span>
            }
            <br />
        }
    }
</div>

<div>
    <h3>Image</h3>
    @if (image != null && listFromNumberValid)
    {
        for (int row = 0; row < 16; row++)
        {
            @string.Format("{0:X4}", (listFromNumber + row * 4))
            for (int i = 0; i < 16; i++)
            {
                <span>@image[(listFromNumber + row * 16) + i].ToString("X2")</span>
            }
            <br />
        }
    }
</div>
@code {


}
